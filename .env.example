# Copy to .env and set unique secrets. DO NOT commit .env
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
APP_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_48_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_GENERATED_KEY
BLINK_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
# Optional GitHub Pages Studio origin (origin only, NO /repo path)
STUDIO_ORIGIN=
# Full GitHub Pages URL, e.g. https://owner.github.io/BLINK (for email links)
STUDIO_PUBLIC_URL=
SECURE_COOKIES=false
# SMTP is REQUIRED for real email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Configure private S3 for production
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Directory containing bin/realesrgan-ncnn-vulkan and models/realesrgan-x4plus.*
AI_MODELS_DIR=./infra/ai-models
